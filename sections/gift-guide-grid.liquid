{% comment %}
  Section: Gift Guide Grid
  ------------------------------------------------------------------
  Built from scratch (no Dawn components).
  - Up to 6 "product" blocks; each product is picked in the customizer.
  - Each tile shows a "+" hotspot (position editable per block).
    Clicking it opens a quick-view popup rendered by gift-guide-grid.js
    from the JSON data printed below - all product data is dynamic.
  - Upsell rule: when the added variant contains BOTH trigger option
    values (default "Black" + "Medium"), the upsell product chosen in
    the section settings (default "Soft Winter Jacket") is also added.
{% endcomment %}

{{ 'gift-guide-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gift-guide-grid.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font
  assign upsell = section.settings.upsell_product
-%}

<style>
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}

  #GiftGuideGrid-{{ section.id }} {
    --gg-heading-font: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --gg-heading-weight: {{ heading_font.weight }};
    --gg-body-font: {{ body_font.family }}, {{ body_font.fallback_families }};
    --gg-body-weight: {{ body_font.weight }};
    --gg-bg: {{ section.settings.background_color }};
    --gg-text: {{ section.settings.text_color }};
    --gg-accent: {{ section.settings.accent_color }};
    --gg-btn-hover-bg: {{ section.settings.button_hover_bg }};
    --gg-btn-hover-text: {{ section.settings.button_hover_text_color }};
    --gg-pad-top: {{ section.settings.padding_top }}px;
    --gg-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
</style>

<section
  id="GiftGuideGrid-{{ section.id }}"
  class="gg-grid"
  data-gg-grid
  aria-labelledby="GiftGuideGridHeading-{{ section.id }}"
>
  <div class="gg-grid__container">
    {%- if section.settings.heading != blank -%}
      <h2 id="GiftGuideGridHeading-{{ section.id }}" class="gg-grid__heading">
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}

    <ul class="gg-grid__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        {%- assign tile_image = block.settings.image | default: product.featured_image -%}

        <li
          class="gg-grid__item"
          style="--gg-hotspot-x: {{ block.settings.hotspot_x }}%; --gg-hotspot-y: {{ block.settings.hotspot_y }}%;"
          {{ block.shopify_attributes }}
        >
          <div class="gg-grid__media">
            {%- if tile_image != blank -%}
              {{
                tile_image
                | image_url: width: 900
                | image_tag:
                  class: 'gg-grid__image',
                  widths: '300, 450, 600, 900',
                  sizes: '(min-width: 990px) 33vw, 50vw',
                  loading: 'lazy',
                  alt: product.title
              }}
            {%- else -%}
              {%- capture placeholder_name -%}product-{{ forloop.index | modulo: 6 | plus: 1 }}{%- endcapture -%}
              {{ placeholder_name | placeholder_svg_tag: 'gg-grid__image gg-grid__image--placeholder' }}
            {%- endif -%}

            {%- if product != blank -%}
              <button
                type="button"
                class="gg-hotspot"
                data-gg-open="{{ block.id }}"
                aria-haspopup="dialog"
                aria-controls="GiftGuidePopup-{{ section.id }}"
                aria-label="Quick view: {{ product.title | escape }}"
              >
                <span class="gg-hotspot__icon" aria-hidden="true"></span>
              </button>

              {%- comment -%}
                Product data for the popup. Prices are pre-formatted with the
                store's money format so the JS never has to format currency.
              {%- endcomment -%}
              <script type="application/json" data-gg-product="{{ block.id }}">
                {
                  "id": {{ product.id | json }},
                  "title": {{ product.title | json }},
                  "description": {{ product.description | strip_html | truncatewords: 40 | json }},
                  "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 300 | json }}{% else %}null{% endif %},
                  "imageAlt": {{ product.featured_image.alt | default: product.title | json }},
                  "price": {{ product.selected_or_first_available_variant.price | money | json }},
                  "hasOnlyDefaultVariant": {{ product.has_only_default_variant | json }},
                  "options": [
                    {%- for option in product.options_with_values -%}
                      { "name": {{ option.name | json }}, "values": {{ option.values | json }} }{% unless forloop.last %},{% endunless %}
                    {%- endfor -%}
                  ],
                  "variants": [
                    {%- for variant in product.variants -%}
                      {
                        "id": {{ variant.id | json }},
                        "options": {{ variant.options | json }},
                        "price": {{ variant.price | money | json }},
                        "available": {{ variant.available | json }}
                      }{% unless forloop.last %},{% endunless %}
                    {%- endfor -%}
                  ]
                }
              </script>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>

  {%- comment -%} Single, shared popup - filled by JS for the clicked product {%- endcomment -%}
  <div
    id="GiftGuidePopup-{{ section.id }}"
    class="gg-popup"
    data-gg-popup
    role="dialog"
    aria-modal="true"
    aria-labelledby="GiftGuidePopupTitle-{{ section.id }}"
    hidden
  >
    <div class="gg-popup__overlay" data-gg-close></div>

    <div class="gg-popup__panel" tabindex="-1">
      <button type="button" class="gg-popup__close" data-gg-close aria-label="Close">
        <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
          <path d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1.4"/>
        </svg>
      </button>

      <div class="gg-popup__top">
        <div class="gg-popup__media">
          <img class="gg-popup__image" data-gg-image alt="" width="150" height="150" loading="lazy">
        </div>
        <div class="gg-popup__info">
          <h3 id="GiftGuidePopupTitle-{{ section.id }}" class="gg-popup__title" data-gg-title></h3>
          <p class="gg-popup__price" data-gg-price></p>
          <p class="gg-popup__description" data-gg-description></p>
        </div>
      </div>

      <form class="gg-popup__form" data-gg-form novalidate>
        {%- comment -%} Option pickers are generated from the product's options {%- endcomment -%}
        <div class="gg-popup__options" data-gg-options></div>

        <p class="gg-popup__message" data-gg-message role="status" aria-live="polite"></p>

        <button
          type="submit"
          class="gg-btn gg-btn--full"
          data-gg-submit
          data-label-default="{{ section.settings.add_to_cart_label | escape }}"
          data-label-unavailable="Sold out"
        >
          <span class="gg-btn__label" data-gg-submit-label>{{ section.settings.add_to_cart_label | escape }}</span>
          {%- render 'gift-guide-arrow', class: 'gg-btn__icon' -%}
        </button>
      </form>
    </div>
  </div>

  {%- comment -%} Settings consumed by gift-guide-grid.js {%- endcomment -%}
  <script type="application/json" data-gg-config>
    {
      "upsellVariantId": {% if upsell != blank and upsell.selected_or_first_available_variant.available %}{{ upsell.selected_or_first_available_variant.id | json }}{% else %}null{% endif %},
      "upsellProductId": {% if upsell != blank %}{{ upsell.id | json }}{% else %}null{% endif %},
      "triggerValues": [{{ section.settings.trigger_value_1 | json }}, {{ section.settings.trigger_value_2 | json }}],
      "cartUrl": {{ routes.cart_url | json }},
      "cartAddUrl": {{ routes.cart_add_url | json }}
    }
  </script>
</section>

{% schema %}
{
  "name": "Gift guide grid",
  "tag": "div",
  "class": "section-gift-guide-grid",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tisso vison in the wild" },
    { "type": "text", "id": "add_to_cart_label", "label": "Add to cart label", "default": "Add to cart" },
    { "type": "header", "content": "Upsell rule" },
    {
      "type": "product",
      "id": "upsell_product",
      "label": "Auto-added product",
      "info": "Added to the cart when the chosen variant matches both values below."
    },
    { "type": "text", "id": "trigger_value_1", "label": "Trigger option value 1", "default": "Black" },
    {
      "type": "text",
      "id": "trigger_value_2",
      "label": "Trigger option value 2",
      "default": "Medium",
      "info": "Separate aliases with a comma, e.g. Medium, M"
    },
    { "type": "header", "content": "Typography" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "lustria_n4" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "jost_n4" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "accent_color", "label": "Buttons / selected state", "default": "#000000" },
    { "type": "color", "id": "button_hover_bg", "label": "Button hover background", "default": "#FFF544" },
    { "type": "color", "id": "button_hover_text_color", "label": "Button hover text", "default": "#000000" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 90 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 50 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom tile image",
          "info": "Optional. Defaults to the product's featured image."
        },
        { "type": "range", "id": "hotspot_x", "label": "Hotspot horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 60 },
        { "type": "range", "id": "hotspot_y", "label": "Hotspot vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 45 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gift guide grid",
      "blocks": [
        { "type": "product" }, { "type": "product" }, { "type": "product" },
        { "type": "product" }, { "type": "product" }, { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
