{% comment %}
  Section: Gift Guide Banner
  ------------------------------------------------------------------
  Built from scratch (no Dawn components).
  - Heading, description, button label/link and bottom-bar text are
    editable from the theme customizer.
  - Illustration is an image_picker; a placeholder SVG is shown until
    an image is uploaded.
  - Desktop (Figma 1440px frame): text on the left over the illustration,
    sizes scale with the viewport so the layout stays pixel-perfect.
    Mobile (Figma 375px frame): centered text, cropped illustration
    below with the button on top.
{% endcomment %}

{{ 'gift-guide-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font
-%}

<style>
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}

  #GiftGuideBanner-{{ section.id }} {
    --gg-heading-font: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --gg-heading-weight: {{ heading_font.weight }};
    --gg-body-font: {{ body_font.family }}, {{ body_font.fallback_families }};
    --gg-body-weight: {{ body_font.weight }};
    --gg-bg: {{ section.settings.background_color }};
    --gg-text: {{ section.settings.text_color }};
    --gg-btn-bg: {{ section.settings.button_bg }};
    --gg-btn-text: {{ section.settings.button_text_color }};
    --gg-btn-hover-bg: {{ section.settings.button_hover_bg }};
    --gg-btn-hover-text: {{ section.settings.button_hover_text_color }};
    --gg-bar-bg: {{ section.settings.bar_bg }};
    --gg-bar-text: {{ section.settings.bar_text_color }};
    --gg-pad-top: {{ section.settings.padding_top }}px;
    --gg-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
</style>

<section
  id="GiftGuideBanner-{{ section.id }}"
  class="gg-banner"
  aria-labelledby="GiftGuideBannerHeading-{{ section.id }}"
>
  <div class="gg-banner__inner">
    {%- comment -%} Text content: editable from the customizer {%- endcomment -%}
    <div class="gg-banner__content">
      {%- if section.settings.heading != blank -%}
        <h1 id="GiftGuideBannerHeading-{{ section.id }}" class="gg-banner__heading">
          {{ section.settings.heading | escape }}
        </h1>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="gg-banner__text">{{ section.settings.description }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        {%- comment -%} Desktop button (hidden on mobile) {%- endcomment -%}
        <a
          class="gg-btn gg-btn--desktop"
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
        >
          <span class="gg-btn__label">{{ section.settings.button_label | escape }}</span>
          {%- render 'gift-guide-arrow', class: 'gg-btn__icon' -%}
        </a>
      {%- endif -%}
    </div>

    {%- comment -%} Illustration {%- endcomment -%}
    <div class="gg-banner__media">
      {%- if section.settings.image != blank -%}
        {%- assign mobile_image = section.settings.image_mobile | default: section.settings.image -%}
        <picture>
          <source
            media="(min-width: 750px)"
            srcset="{{ section.settings.image | image_url: width: 1500 }} 1500w, {{ section.settings.image | image_url: width: 2400 }} 2400w, {{ section.settings.image | image_url: width: 3200 }} 3200w"
            sizes="100vw"
          >
          {{
            mobile_image
            | image_url: width: 1000
            | image_tag:
              class: 'gg-banner__image',
              widths: '400, 600, 800, 1000',
              sizes: '100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: section.settings.image.alt
          }}
        </picture>
      {%- else -%}
        {{ 'collection-1' | placeholder_svg_tag: 'gg-banner__image gg-banner__image--placeholder' }}
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        {%- comment -%} Mobile button sits on top of the illustration {%- endcomment -%}
        <a
          class="gg-btn gg-btn--mobile"
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
        >
          <span class="gg-btn__label">{{ section.settings.button_label | escape }}</span>
          {%- render 'gift-guide-arrow', class: 'gg-btn__icon' -%}
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.bar_text != blank -%}
    <div class="gg-banner__bar">
      <p class="gg-banner__bar-text">{{ section.settings.bar_text | escape }}</p>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Gift guide banner",
  "tag": "div",
  "class": "section-gift-guide-banner",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Gift Guide" },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "text",
      "id": "bar_text",
      "label": "Bottom bar text",
      "default": "Sustainable, ethically made clothes in sizes XXS to 6XL"
    },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Illustration (desktop)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Illustration (mobile)", "info": "Optional. Falls back to the desktop image." },
    { "type": "header", "content": "Typography" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "jost_n5" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "jost_n4" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#000000" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FFFFFF" },
    { "type": "color", "id": "button_hover_bg", "label": "Button hover background", "default": "#FFF544" },
    { "type": "color", "id": "button_hover_text_color", "label": "Button hover text", "default": "#000000" },
    { "type": "color", "id": "bar_bg", "label": "Bottom bar background", "default": "#F5F5F5" },
    { "type": "color", "id": "bar_text_color", "label": "Bottom bar text", "default": "#000000" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "Gift guide banner" }]
}
{% endschema %}
